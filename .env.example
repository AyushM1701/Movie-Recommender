# CineMatch — Environment Variables
# Copy this file to .env and fill in your values.

# Optional for offline browsing; required for live details, watch availability,
# poster lookup and catalog refresh: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# JWT signing key — use a long random string in production
CINEMATCH_SECRET_KEY=

# development | production. Production requires CINEMATCH_SECRET_KEY.
CINEMATCH_ENVIRONMENT=development

# Optional: defaults to a SQLite database in data/ for local development.
# CINEMATCH_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: suppress network poster lookup while testing offline.
CINEMATCH_ENABLE_POSTER_LOOKUP=1

# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
CINEMATCH_TRUST_PROXY_HEADERS=0
